# Provedor de IA: mock | openai | gemini
# Sem chave configurada o app usa automaticamente o "Mock Inteligente".
VITE_AI_PROVIDER=mock

# OpenAI
VITE_OPENAI_API_KEY=
VITE_OPENAI_MODEL=gpt-4o-mini

# Google Gemini
VITE_GEMINI_API_KEY=
VITE_GEMINI_MODEL=gemini-2.0-flash

# Opcional: URL de um proxy/backend próprio que recebe { kind, input } e
# devolve o JSON do roadmap. Recomendado em produção para não expor chaves.
VITE_AI_PROXY_URL=
