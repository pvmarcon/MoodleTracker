{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": ["../src/*"],
      "~/*": ["./src/*"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "expo-env.d.ts", "../src/types/**/*.ts", "../src/domain/**/*.ts", "../src/lib/**/*.ts", "../src/services/**/*.ts", "../src/data/**/*.ts", "../src/store/AppStore.tsx"]
}
