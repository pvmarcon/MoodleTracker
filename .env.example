# ============================================================================
# MoodleTracker — todas as variáveis usam o prefixo MT_ (Pydantic Settings).
# Copie para .env e ajuste. Valores abaixo = padrões.
# ============================================================================

# --- Banco (docker compose up -d db) ------------------------------------------
MT_DATABASE_URL=postgresql+psycopg://moodletracker:moodletracker@localhost:5432/moodletracker
MT_DB_POOL_SIZE=5

# --- Coleta ---------------------------------------------------------------------
# local_folder (agora) | moodle (próxima fase — exige MT_MOODLE_BASE_URL/MT_MOODLE_TOKEN)
MT_COLLECTOR_ADAPTER=local_folder
# Estrutura esperada: data/inbox/<Disciplina>/<Aula ou Módulo>/arquivo.(pdf|pptx|html)
MT_INBOX_DIR=data/inbox
MT_SUPPORTED_EXTENSIONS=pdf,pptx,html,htm
MT_MAX_FILE_MB=100

# --- Second Brain (pasta .md compatível com Obsidian/Git) ------------------------
MT_BRAIN_DIR=data/brain
MT_PARTITION_MAX_CHARS=12000

# --- Chunking / embeddings ------------------------------------------------------
MT_CHUNK_SIZE=1200
MT_CHUNK_OVERLAP=150
# none = para no estágio "chunked" | openai = qualquer API compatível com /v1/embeddings
MT_EMBEDDING_PROVIDER=none
# Ollama: http://localhost:11434/v1 + nomic-embed-text (768)
# OpenAI: https://api.openai.com/v1 + text-embedding-3-small (1536) + MT_EMBEDDING_API_KEY
MT_EMBEDDING_BASE_URL=http://localhost:11434/v1
MT_EMBEDDING_API_KEY=
MT_EMBEDDING_MODEL=nomic-embed-text
# Fixada na criação do banco (coluna vector(N)). Mudar depois exige recriar o banco.
MT_EMBEDDING_DIM=768
MT_EMBEDDING_BATCH_SIZE=32

# --- LLM (agente de rascunho — próxima fase) -------------------------------------
MT_LLM_BASE_URL=http://localhost:11434/v1
MT_LLM_API_KEY=
MT_LLM_MODEL=llama3.1

# --- Moodle (conector — próxima fase) --------------------------------------------
# MT_MOODLE_BASE_URL=https://moodle.suainstituicao.edu.br
# MT_MOODLE_TOKEN=

# --- Agendamento -----------------------------------------------------------------
MT_SCHEDULER_ENABLED=true
MT_SCHEDULE_INTERVAL_SECONDS=300

# --- API / Web UI ----------------------------------------------------------------
MT_API_HOST=127.0.0.1
MT_API_PORT=8000

# --- Logs (console | json) -------------------------------------------------------
MT_LOG_LEVEL=INFO
MT_LOG_FORMAT=console
